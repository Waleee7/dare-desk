# --- LLM (Anthropic) -------------------------------------------------------
# Without a key, scorers fall back to deterministic heuristics (pipeline still runs).
ANTHROPIC_API_KEY=

# Models. Default to the most capable; override to sonnet/haiku for high call volume.
SCORER_MODEL=claude-opus-4-8
PARSER_MODEL=claude-opus-4-8
# Effort for per-factor scorers: low | medium | high | max  (low keeps volume cheap)
SCORER_EFFORT=low

# --- Risk discipline (firewall) -------------------------------------------
ACCOUNT_SIZE_USD=10000
MAX_RISK_PER_TRADE_PCT=1
MAX_DAILY_LOSS_PCT=3
MAX_TRADES_PER_DAY=5
MAX_CONSECUTIVE_LOSSES=2
COOLDOWN_MINUTES=45
MIN_REWARD_RISK=1.5
MAX_SPREAD_PCT=8
MIN_REGIME_SCORE=50

# --- Universe + discipline upgrades (2026-07) ------------------------------
EXTENDED_MIN_CONF=90   # non-Core/Focus names need A+ (>=90) to fire
MAX_CORRELATED_HEAT=2  # max simultaneous same-direction trades per correlation cluster
CHASE_GUARD_PCT=0.4    # block if price left the entry zone by more than this %
NAME_COOLDOWN_MIN=20   # per-ticker lock after a loss (revenge-trade guard)
SUPPRESS_LUNCH=true    # suppress new signals 11:30-13:30 ET (lunch chop)
LUNCH_START=690        # 11:30 ET (minutes past ET midnight)
LUNCH_END=810          # 13:30 ET
ZERO_DTE_FLAT=955      # 15:55 ET — be flat on 0DTE; no new 0DTE opens after this
MIN_PAPER_TRADES=100   # prove-it gate: paper trades before any performance claim

# --- Discipline memory + truth gates (2026-07 Tier 1+2) ---------------------
MAX_OPEN_POSITIONS=5        # concurrent paper positions cap
MAX_OPEN_RISK_PCT=3         # total open premium-at-risk cap (% of account)
PROFIT_LOCK_TRIGGER_PCT=2   # arm the give-back guard once the day peaks at +2%
PROFIT_LOCK_GIVEBACK_PCT=50 # stand down if 50% of the day's peak gives back
WEEKLY_BREAKER_LOSS_PCT=6   # rolling 5-day realized loss beyond this % → stand down
RED_STREAK_DAYS=3           # consecutive red days → half-size until a green day
OPENING_GUARD_MIN=10        # first N minutes after the open are watch-only (0 = off)
THETA_BUDGET_PCT=35         # block entries whose modeled decay eats >35% of the TP1 gain
REFIRE_COOLDOWN_MIN=45      # same ticker+setup+direction re-fire lock (unless grade upgrades)
ZERO_DTE_WINDOWS=580-660,840-915  # 0DTE entries only 9:40-11:00 + 14:00-15:15 ET (gamma windows)

# Grade thresholds (earned-confidence %). A+ is the Extended-universe bar.
GRADE_APLUS=90
GRADE_A=80
GRADE_B=70
GRADE_C=60

# Modeled paper-fill assumptions (no live options chain — all estimates).
FILL_SPREAD_PCT=5
FILL_SLIPPAGE_PCT=1.5
FILL_COMMISSION=0.65

# --- Execution (DANGER) ----------------------------------------------------
# Live trading is OFF by default. Paper is the only enabled broker until you
# flip this AND pass an explicit per-run unlock. Robinhood agentic options exec
# is still rolling out; equities are live.
LIVE_TRADING=false
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading

# --- Market data feed (Alpaca) ---------------------------------------------
# Robinhood has NO data API (execution-only). The live feed is Alpaca — free,
# real-time IEX for the underlyings. Get free keys at alpaca.markets.
# Without keys, the scanner falls back to a mock feed so it still runs.
ALPACA_API_KEY=
ALPACA_SECRET=
ALPACA_FEED=iex
# Backup verified-news feed (free key at alphavantage.co). Alpaca News is primary.
ALPHAVANTAGE_API_KEY=
# More free, verified sources (optional — providers degrade gracefully without them).
FINNHUB_API_KEY=      # finnhub.io — company news + earnings + econ calendar (free tier)
FMP_API_KEY=          # financialmodelingprep.com — news + economic/earnings calendar (free)
FRED_API_KEY=         # fred.stlouisfed.org — official macro (yields/rates/dollar), free

# --- Continuous runner ("npm run go") --------------------------------------
# Fastest cadence the free Alpaca tier sustains for a fresh full-universe scan.
# The ARMED pre-alert + chase guard are what actually prevent missed entries;
# go below ~30s only with a paid real-time feed.
SCAN_INTERVAL_SEC=30
RUN_OFFHOURS=false

# --- ARMED pre-trigger alerts (strongest plays only) -----------------------
ARM_PROXIMITY_PCT=0.18   # arm when price is within this % of the trigger level
ARM_MIN_RVOL=1.5         # require this much relative volume (hot participation)
ARM_COOLDOWN_MIN=20      # per ticker+direction+level re-arm lock (anti-spam)

# --- Discord (output) ------------------------------------------------------
# Multi-channel server layout. Each channel = a webhook URL (channel settings →
# Integrations → Webhooks → New Webhook → copy URL). Everything degrades
# gracefully: with only DISCORD_WEBHOOK_URL set, all output lands in one channel
# (except #news, which stays silent rather than spamming signals).
DISCORD_WEBHOOK_URL=              # #signals — A+/A entries (the main feed)
DISCORD_WATCH_WEBHOOK_URL=        # #watching — B-grade setups (falls back to main)
DISCORD_TRADE_MGMT_WEBHOOK_URL=   # #trade-management — exit monitor talk + EOD recap (falls back to main)
DISCORD_NEWS_WEBHOOK_URL=         # #news — breaking headlines (silent when unset)
DISCORD_MAG7_WEBHOOK_URL=         # #mag7 — fires on mag7/semis names cross-post here (optional)
DISCORD_INDEX_WEBHOOK_URL=        # #spy-qqq — fires on index ETFs cross-post here (optional)
DISCORD_ARMED_WEBHOOK_URL=        # #armed — pre-trigger "get ready" heads-up (falls back to #signals)
